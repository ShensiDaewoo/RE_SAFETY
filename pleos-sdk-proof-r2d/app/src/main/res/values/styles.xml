<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light app surface. The Pleos title bar above the app is dark, so its text colour must be light. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.DarkActionBar">
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:windowTitleStyle">@style/AppTitle</item>
    </style>
    <style name="AppTitle" parent="@android:style/TextAppearance.DeviceDefault.Medium">
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
</resources>
